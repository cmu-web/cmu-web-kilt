{
  "name": "@cmu-web/kilt",
  "version": "0.8.27",
  "description": "Components for pages on Carnegie Mellon's web template: CMS sites and web apps.",
  "license": "BSD-3-Clause",
  "homepage": "https://webkilt.andrew.cmu.edu/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmu-web/cmu-web-kilt.git"
  },
  "bugs": "https://github.com/cmu-web/cmu-web-kilt/issues",
  "files": [
    "bin",
    "css",
    "js"
  ],
  "bin": {
    "cmu-web-kilt-links": "bin/cmu-web-kilt-links.mjs"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "check": "npm run lint && npm run format:check && npm run check:versions && npm run check:components && npm run check:gallery && npm run check:template && npm run check:opengraph && npm run check:data && npm run test:preview && npm run test:initials && npm run test:links",
    "check:template": "node tools/check-template.mjs",
    "check:versions": "node tools/versions.mjs",
    "check:components": "node tools/components.mjs --check",
    "check:gallery": "node tools/gallery.mjs --check",
    "check:opengraph": "node tools/opengraph.mjs --check",
    "check:data": "node tools/data.mjs --check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "components": "node tools/components.mjs",
    "data": "node tools/data.mjs",
    "docs": "node tools/serve.mjs",
    "gallery": "node tools/gallery.mjs",
    "opengraph": "node tools/opengraph.mjs",
    "preview": "node tools/preview.mjs",
    "release": "node tools/versions.mjs",
    "test:browser": "node --test tools/turbo.browser.test.mjs",
    "test:initials": "node --test tools/initials.test.mjs",
    "test:preview": "node --test tools/preview.test.mjs",
    "test:links": "node --test tools/links.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@j178/prek": "^0.5.11",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright": "1.65.1",
    "prettier": "^3.10.1"
  },
  "integrity": {
    "css/cmu-cms.css": "sha384-LIVlnwpFZ85qeR3bUtsanQE+zGu5kfDo8jC1ZHRWwuUQCCzcL4a0H1qPVeFoLVju",
    "css/cmu-app.css": "sha384-mMAydCgtKtKAZrOtcGDkHGdvycaNc3urFvf2z6rekMylJFq3e3eFl3e6RE1OFJu1",
    "js/cmu-app.js": "sha384-2rrCJjbHKDM0Jk/5lx7uQxL7iqJQ+9eh8jQgJG3fS0tejTSfMv2zFpmXQqW0VB+g"
  }
}
