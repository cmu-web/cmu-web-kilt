    "check:data": "node tools/data.mjs --check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "components": "node tools/components.mjs",
    "data": "node tools/data.mjs",
    "docs": "node tools/serve.mjs",
    "gallery": "node tools/gallery.mjs",
    "opengraph": "node tools/opengraph.mjs",
    "preview": "node tools/preview.mjs",
    "release": "node tools/versions.mjs",
    "test:browser": "node --test tools/turbo.browser.test.mjs",
    "test:initials": "node --test tools/initials.test.mjs",
    "test:preview": "node --test tools/preview.test.mjs"
  },
  "private": true,
