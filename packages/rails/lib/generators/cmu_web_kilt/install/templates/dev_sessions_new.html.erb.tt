<%% cmu_title "Sign In With a Test Account" %>
<%%# The kit's Developer Sign-In (accounts.html#developer-sign-in) %>
<main id="content" class="cmu-sign-in-page cmu-sign-in-page--dev">
  <div class="content">
    <div>
      <h1>Sign In</h1>
      <p>to&nbsp;<%%= CmuWebKilt.config.site_name %></p>
    </div>
    <div class="cmu-sign-in-card">
      <p class="cmu-label">Development Mode</p>
      <h2>Pick a Test Account</h2>
      <ul class="cmu-dev-people">
        <%% @accounts.each do |account| %>
          <%% current = Current.user&.andrew_id == account["andrew_id"] %>
          <%%= tag.li(**(current ? { "aria-current": "true" } : {})) do %>
            <%% if current %>
              <div class="cmu-dev-card">
                <i class="cmu-profile-picture cmu-profile-initials" aria-hidden="true" data-cmu-name="<%%= account["name"] %>"></i>
                <strong><%%= account["name"] %></strong>
                <span><%%= account["role"] %></span>
                <small><%%= account["can"] %></small>
                <span class="cmu-dev-you">You</span>
              </div>
            <%% else %>
              <%%= form_with url: dev_sign_in_as_path(account["andrew_id"]), method: :post, data: { turbo: false } do %>
                <%%= hidden_field_tag :return_to, @return_to, id: nil %>
                <button type="submit" class="cmu-dev-card btn ghost">
                  <i class="cmu-profile-picture cmu-profile-initials" aria-hidden="true" data-cmu-name="<%%= account["name"] %>"></i>
                  <strong><span class="sr-only">Sign in as </span><%%= account["name"] %></strong>
                  <span><%%= account["role"] %></span>
                  <small><%%= account["can"] %></small>
                </button>
              <%% end %>
            <%% end %>
          <%% end %>
        <%% end %>
        <%%= tag.li(**(Current.user ? {} : { "aria-current": "true" })) do %>
          <%% if Current.user %>
            <%%= form_with url: logout_path, method: :get, data: { turbo: false } do %>
              <button type="submit" class="cmu-dev-card cmu-dev-card--out btn ghost">
                <i class="cmu-profile-picture cmu-profile-initials" aria-hidden="true"></i>
                <strong>Signed Out</strong>
                <span>Visitor</span>
                <small>See what a visitor sees.</small>
              </button>
            <%% end %>
          <%% else %>
            <div class="cmu-dev-card cmu-dev-card--out">
              <i class="cmu-profile-picture cmu-profile-initials" aria-hidden="true"></i>
              <strong>Signed Out</strong>
              <span>Visitor</span>
              <small>See what a visitor sees.</small>
              <span class="cmu-dev-you">You</span>
            </div>
          <%% end %>
        <%% end %>
      </ul>
    </div>
  </div>
</main>
