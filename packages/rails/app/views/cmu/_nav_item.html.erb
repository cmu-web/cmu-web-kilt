<%# locals: (item:, current:) -%>
<%# One item and its sub-list. active marks the current item; the template
    marks the items above it. A link to another site gets the template's
    external class, which adds its leave-site icon. %>
<%= tag.li class: { secondary: item.secondary, active: item.key == current } do %>
  <% external = item.url.to_s.match?(%r{\A(https?:)?//}) %>
  <%= link_to item.label, item.url, class: ("external" if external),
              aria: { current: ("page" if !external && current_page?(item.url)) } %>
  <% if item.children.any? %>
    <ul>
      <%= render partial: "cmu/nav_item", collection: item.children, as: :item, locals: { current: } %>
    </ul>
  <% end %>
<% end %>
